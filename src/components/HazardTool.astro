---
// The interactive figure: controls, two Plotly panels, per-model readout.
// All behaviour lives in the client script below (the "island").
---

<section class="tool" aria-label="Interactive fault MFD → hazard explorer">
  <div class="tool-grid">
    <!-- CONTROLS -->
    <div class="controls">
      <div class="card">
        <p class="eyebrow">Models shown</p>
        <div class="chips" id="chips">
          <button class="chip on" data-m="GR" aria-pressed="true"><span class="dot"></span>GR (no cap)</button>
          <button class="chip on" data-m="TGR" aria-pressed="true"><span class="dot"></span>Truncated GR</button>
          <button class="chip on" data-m="CHAR" aria-pressed="true"><span class="dot"></span>Characteristic</button>
          <button class="chip on" data-m="MMAX" aria-pressed="true"><span class="dot"></span>M<sub>max</sub></button>
        </div>
      </div>

      <div class="card">
        <p class="eyebrow">Fault &amp; rate</p>
        <div class="ctl"><label for="b">b-value<span class="val" id="vb">1.00</span></label>
          <input type="range" id="b" min="0.70" max="1.30" step="0.01" value="1.00"></div>
        <div class="ctl"><label for="slip">Slip rate<span class="val" id="vslip">0.30 <span class="u">mm/yr</span></span></label>
          <input type="range" id="slip" min="0" max="1000" step="1" value="425"></div>
        <div class="ctl"><label for="len">Fault length<span class="val" id="vlen">40 <span class="u">km</span></span></label>
          <input type="range" id="len" min="5" max="200" step="1" value="40"></div>
        <div class="ctl"><label for="wid">Down-dip width<span class="val" id="vwid">15 <span class="u">km</span></span></label>
          <input type="range" id="wid" min="5" max="25" step="1" value="15"></div>
        <div class="ctl"><label for="mmin"><span>M<sub>min</sub></span><span class="val" id="vmmin">5.0</span></label>
          <input type="range" id="mmin" min="4.5" max="6.0" step="0.1" value="5.0"></div>
      </div>

      <div class="card">
        <p class="eyebrow">Maximum magnitude</p>
        <label class="check"><input type="checkbox" id="lockmax" checked>
          Lock to area scaling <span class="u">(Wells &amp; Coppersmith 1994)</span></label>
        <div class="ctl"><label for="mmax"><span>M<sub>max</sub></span><span class="val" id="vmmax">—</span></label>
          <input type="range" id="mmax" min="5.5" max="8.0" step="0.01" value="6.79" disabled></div>
        <div class="note" id="scalenote"></div>
        <div class="segwarn" id="segnote"></div>
      </div>

      <div class="card">
        <p class="eyebrow">Site &amp; ground motion</p>
        <div class="ctl"><label for="r">Site distance<span class="val" id="vr">10 <span class="u">km</span></span></label>
          <input type="range" id="r" min="2" max="60" step="1" value="10"></div>
        <div class="ctl"><label for="vs30"><span>V<sub>S30</sub></span><span class="val" id="vvs30">760 <span class="u">m/s</span></span></label>
          <input type="range" id="vs30" min="150" max="1100" step="10" value="760"></div>
        <div class="ctl"><label for="gmpe">Ground-motion model</label>
          <select id="gmpe">
            <option value="allen" selected>Allen 2012 — SE Aus. SCR (+SS14 site)</option>
            <option value="gen">Generic active-crust (toy)</option>
            <option value="scr">SCR hard-rock (toy)</option>
          </select></div>
        <p class="note"><b>Allen 2012</b> is the real cratonic <code>gsim</code>, validated
          against OpenQuake. V<sub>S30</sub> drives its Seyhan &amp; Stewart (2014) site
          term (820&nbsp;m/s reference). The toy models ignore V<sub>S30</sub>.</p>
      </div>

      <div class="card">
        <p class="eyebrow">Presets</p>
        <div class="presets">
          <button class="preset" data-p="se">SE Australia (SCR)</button>
          <button class="preset" data-p="nz">NZ Alpine</button>
          <button class="preset" data-p="reset">Reset</button>
        </div>
      </div>
    </div>

    <!-- CHARTS + READOUT -->
    <div class="charts">
      <div class="plots">
        <div class="card plot-card"><div id="mfd" class="plot"></div></div>
        <div class="card plot-card"><div id="haz" class="plot"></div></div>
      </div>

      <div class="tiles">
        <div class="tile"><div class="k">Moment rate</div><div class="v" id="t_mo">—</div></div>
        <div class="tile"><div class="k">Area · M<sub>max</sub>(scaling)</div><div class="v" id="t_area">—</div></div>
      </div>

      <div class="card readout-card">
        <p class="eyebrow">Per-model readout</p>
        <table>
          <thead><tr><th>Model</th><th>Recur. M<sub>max</sub></th>
            <th>PGA · 475 yr</th><th>PGA · 2475 yr</th></tr></thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHazardTool } from '../tool/HazardTool';
  initHazardTool();
</script>

<style>
  .tool { font-family: var(--font-mono); }

  .tool-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .tool-grid { grid-template-columns: 1fr; }
  }

  /* keep controls in view while exploring the curves */
  @media (min-width: 861px) {
    .controls {
      position: sticky;
      top: 4.5rem;
      max-height: calc(100vh - 5.5rem);
      overflow-y: auto;
      padding-right: 2px;
      scrollbar-width: thin;
    }
  }

  .card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.15rem;
  }
  .controls .card + .card { margin-top: 1rem; }

  .eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 500;
    margin: 0 0 0.95rem;
  }

  /* :global — .u spans are also injected at runtime (readout values) */
  .tool :global(.u) { color: var(--ink-muted); font-weight: 400; }

  /* sliders */
  .ctl { margin-bottom: 1rem; }
  .ctl:last-child { margin-bottom: 0; }
  .ctl label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    margin-bottom: 0.5rem;
  }
  .ctl .val { font-size: 0.82rem; color: var(--ink); font-weight: 500; }

  input[type='range'] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 2px; border-radius: 2px;
    background: var(--border); outline: none; margin: 0.35rem 0;
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; width: 15px; height: 15px; border-radius: 50%;
    background: var(--primary); cursor: pointer;
    border: 2px solid #fff; box-shadow: 0 0 0 1px var(--primary);
  }
  input[type='range']::-moz-range-thumb {
    width: 13px; height: 13px; border-radius: 50%; background: var(--primary);
    cursor: pointer; border: 2px solid #fff;
  }
  input[type='range']:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px var(--primary-wash);
  }
  input[type='range']:disabled { opacity: 0.4; }
  input[type='range']:disabled::-webkit-slider-thumb { background: var(--border-strong); box-shadow: none; }

  /* chips */
  .chips { display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.01em;
    padding: 0.4rem 0.6rem; border-radius: var(--radius); border: 1px solid var(--border);
    background: var(--panel); color: var(--ink-muted); cursor: pointer;
    display: flex; align-items: center; gap: 0.4rem; transition: 0.14s;
  }
  .chip .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: 0.4; }
  .chip.on { color: var(--ink); border-color: var(--border-strong); background: #fff; }
  .chip.on .dot { opacity: 1; }
  .chip[data-m='GR'].on .dot { color: var(--c-gr); }
  .chip[data-m='TGR'].on .dot { color: var(--c-tgr); }
  .chip[data-m='CHAR'].on .dot { color: var(--c-char); }
  .chip[data-m='MMAX'].on .dot { color: var(--c-mmax); }
  .chip:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }

  /* check + select */
  .check {
    display: flex; align-items: flex-start; gap: 0.5rem;
    font-size: 0.78rem; color: var(--ink-secondary); cursor: pointer; user-select: none;
    margin-bottom: 0.8rem; line-height: 1.4;
  }
  .check input { accent-color: var(--primary); width: 14px; height: 14px; margin-top: 1px; }
  select {
    width: 100%; background: #fff; color: var(--ink);
    border: 1px solid var(--border-strong); border-radius: var(--radius); padding: 0.45rem 0.55rem;
    font-family: var(--font-mono); font-size: 0.78rem;
  }
  select:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }

  .note { margin-top: 0.7rem; font-size: 0.72rem; line-height: 1.55; color: var(--ink-muted); }
  .note code { color: var(--primary); }
  .segwarn {
    margin-top: 0.7rem; padding: 0.55rem 0.7rem; border-radius: var(--radius);
    background: var(--primary-wash); border-left: 4px solid var(--primary);
    font-size: 0.72rem; color: var(--ink-secondary); line-height: 1.45; display: none;
  }
  .segwarn.show { display: block; }

  /* presets */
  .presets { display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .preset {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.01em;
    padding: 0.45rem 0.65rem; border-radius: var(--radius); border: 1px solid var(--border-strong);
    background: #fff; color: var(--ink-secondary); cursor: pointer; transition: 0.14s;
  }
  .preset:hover { color: var(--ink); background: var(--panel); }
  .preset:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }

  /* charts */
  .charts { display: flex; flex-direction: column; gap: 1rem; }
  .plots { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 1180px) {
    .plots { grid-template-columns: 1fr 1fr; }
  }
  .plot-card { padding: 0.6rem 0.5rem 0.2rem; }
  .plot { width: 100%; height: 360px; }
  @media (max-width: 860px) { .plot { height: 280px; } }

  /* readout */
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .tile {
    background: #fff; border: 1px solid var(--border);
    border-top: 3px solid var(--primary); border-radius: var(--radius); padding: 0.8rem 0.9rem;
  }
  .tile .k { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  .tile .v { font-family: var(--font-body); font-size: 1.25rem; font-weight: 700; margin-top: 0.25rem; color: var(--ink); }

  table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 0.8rem; }
  th {
    text-align: right; font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-secondary); font-weight: 500; padding: 8px 12px;
    background: var(--panel); border-bottom: 2px solid var(--navy); white-space: nowrap;
  }
  th:first-child { text-align: left; }
  /* :global — tbody rows are injected at runtime, so scoped selectors miss them */
  .readout-card :global(td) { text-align: right; padding: 7px 12px; border-bottom: 1px solid var(--border); color: var(--ink); }
  .readout-card :global(td:first-child) { text-align: left; color: var(--ink-secondary); }
  .readout-card :global(tr:last-child td) { border-bottom: none; }
  .readout-card :global(tbody tr:hover) { background: var(--primary-wash); }
  .readout-card :global(.mdot) { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 0.5rem; vertical-align: middle; }
  .readout-card :global(tr.off) { opacity: 0.32; }
</style>
